APP_NAME=ManaVoice AI
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api/v1
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=manavoice_ai
JWT_SECRET_KEY=mana_voice_super_secret_jwt_key_2026_antigravity_token
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TTS_PROVIDER=transformers
TTS_MODEL_DEFAULT=facebook/mms-tts-eng
DEVICE=cpu
HF_HOME=D:/ManaVoice_Data/cache/huggingface
TRANSFORMERS_CACHE=D:/ManaVoice_Data/cache/huggingface/hub
PIP_CACHE_DIR=D:/ManaVoice_Data/cache/pip
TORCH_HOME=D:/ManaVoice_Data/cache/torch
TRANSLATION_PROVIDER=libretranslate
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=
STORAGE_PROVIDER=local
AUDIO_STORAGE_DIR=./storage/audio
MEDIA_STORAGE_DIR=./storage/media
VIDEO_STORAGE_DIR=./storage/video
SUBTITLE_STORAGE_DIR=./storage/subtitles
DATASET_STORAGE_DIR=./storage/datasets
MODELS_STORAGE_DIR=./storage/models
SCRATCH_STORAGE_DIR=./storage/scratch

# ASR & Lip-Sync
ASR_PROVIDER=whisper
ASR_MODEL_DEFAULT=openai/whisper-large-v3-turbo
LIPSYNC_ENABLED=true

# Kaggle API Credentials (Placeholders only - Never commit secrets)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

MAX_TEXT_LENGTH=5000
MAX_MEDIA_FILE_SIZE_MB=100
MAX_VIDEO_DURATION_SECONDS=900
MAX_CONCURRENT_GENERATIONS=2
REQUEST_TIMEOUT_SECONDS=300

