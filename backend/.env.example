APP_NAME=ManaVoice AI
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api/v1
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=manavoice_ai
JWT_SECRET_KEY=mana_voice_super_secret_jwt_key_2026_antigravity_token
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TTS_PROVIDER=transformers
TTS_MODEL_DEFAULT=facebook/mms-tts-eng
DEVICE=cpu
HF_HOME=./.cache/huggingface
TRANSLATION_PROVIDER=libretranslate
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=
STORAGE_PROVIDER=local
AUDIO_STORAGE_DIR=./storage/audio
MAX_TEXT_LENGTH=3000
MAX_CONCURRENT_GENERATIONS=1
REQUEST_TIMEOUT_SECONDS=120
